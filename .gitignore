# .gitignore for Microservices Demo

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
build/
dist/
*.tsbuildinfo

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Kubernetes
*.kubeconfig
**/secrets.yaml
**/secret-*.yaml

# Docker
.dockerignore

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/
*.lcov

# Temporary files
tmp/
temp/
*.tmp

# OS
Thumbs.db
.DS_Store

# CI/CD
.github/secrets/

# Helm
helm/**/charts/
helm/**/*.tgz

# Azure
.azure/